# ==============================================================================
# Paperless-GPT Advanced Configuration Template
# ==============================================================================
# Rename this file to `paperless-gpt.env` to activate it. 
# Any variables defined here will override the basic UI configuration.
# 
# Uncomment (remove the '#') and set the value for any variables you want to change.
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Paperless-ngx Connection
# ------------------------------------------------------------------------------
# PAPERLESS_BASE_URL=http://ca5234a0-paperless-ngx:80
# PAPERLESS_API_TOKEN=
# PAPERLESS_PUBLIC_URL=
# PUID=10001
# PGID=10001
# LOG_LEVEL=info
# LISTEN_INTERFACE=8080

# ------------------------------------------------------------------------------
# Main LLM Provider (Metadata & Tags)
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_LANGUAGE=English
# LLM_REQUESTS_PER_MINUTE=120
# LLM_MAX_RETRIES=3
# LLM_BACKOFF_MAX_WAIT=30s
# TOKEN_LIMIT=

# API Keys
# OPENAI_API_KEY=
# OPENAI_API_TYPE=
# OPENAI_BASE_URL=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLEAI_API_KEY=

# Ollama Specific
# OLLAMA_HOST=
# OLLAMA_THINK=false
# OLLAMA_CONTEXT_LENGTH=
# OLLAMA_HEADERS=

# Gemini Specific
# GOOGLEAI_THINKING_BUDGET=

# ------------------------------------------------------------------------------
# OCR / Vision Settings (For reading PDFs)
# ------------------------------------------------------------------------------
# OCR_PROVIDER=llm
# OCR_PROCESS_MODE=image
# OCR_LIMIT_PAGES=5
# OCR_MAX_RETRIES=3

# Vision LLM (If OCR_PROVIDER=llm)
# VISION_LLM_PROVIDER=openai
# VISION_LLM_MODEL=gpt-4o
# VISION_LLM_REQUESTS_PER_MINUTE=120
# VISION_LLM_MAX_RETRIES=3
# VISION_LLM_BACKOFF_MAX_WAIT=30s
# VISION_LLM_MAX_TOKENS=
# VISION_LLM_TEMPERATURE=
# OLLAMA_OCR_TOP_K=

# Azure Document Intelligence (If OCR_PROVIDER=azure)
# AZURE_DOCAI_ENDPOINT=
# AZURE_DOCAI_KEY=
# AZURE_DOCAI_MODEL_ID=prebuilt-read
# AZURE_DOCAI_TIMEOUT_SECONDS=120
# AZURE_DOCAI_OUTPUT_CONTENT_FORMAT=text

# Google Cloud Document AI (If OCR_PROVIDER=google_docai)
# GOOGLE_PROJECT_ID=
# GOOGLE_LOCATION=
# GOOGLE_PROCESSOR_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Docling (If OCR_PROVIDER=docling)
# DOCLING_URL=
# DOCLING_IMAGE_EXPORT_MODE=embedded
# DOCLING_OCR_PIPELINE=vlm
# DOCLING_OCR_ENGINE=easyocr

# ------------------------------------------------------------------------------
# Tags & Automation Triggers
# ------------------------------------------------------------------------------
# MANUAL_TAG=paperless-gpt
# AUTO_TAG=paperless-gpt-auto
# FAIL_TAG=paperless-gpt-failed
# AUTO_TAG_COMPLETE=paperless-gpt-auto-complete
# AUTO_OCR_TAG=paperless-gpt-ocr-auto
# PDF_OCR_COMPLETE_TAG=paperless-gpt-ocr-complete

# Automation Generation Toggles
# AUTO_GENERATE_TITLE=true
# AUTO_GENERATE_TAGS=true
# CREATE_NEW_TAGS=false
# AUTO_GENERATE_CORRESPONDENTS=true
# AUTO_GENERATE_DOCUMENT_TYPE=true
# AUTO_GENERATE_CREATED_DATE=true

# Suggestion Tuning
# SUGGESTION_WORKERS=1
# SUGGESTION_JOB_TIMEOUT_SECONDS=
# REMOVE_FROM_CONTENT=
# REMOVE_FROM_CONTENT_REGEX=
# CORRESPONDENT_BLACK_LIST=

# ------------------------------------------------------------------------------
# Local PDF/hOCR Generation
# ------------------------------------------------------------------------------
# CREATE_LOCAL_HOCR=false
# LOCAL_HOCR_PATH=/app/hocr
# CREATE_LOCAL_PDF=false
# LOCAL_PDF_PATH=/app/pdf
# PDF_UPLOAD=false
# PDF_REPLACE=false
# PDF_COPY_METADATA=true
# PDF_OCR_TAGGING=true
# PDF_SKIP_EXISTING_OCR=false

# Image Processing Limits (For PDF->Image conversion)
# IMAGE_MAX_PIXEL_DIMENSION=10000
# IMAGE_MAX_TOTAL_PIXELS=40000000
# IMAGE_MAX_RENDER_DPI=600
# IMAGE_MAX_FILE_BYTES=10485760
